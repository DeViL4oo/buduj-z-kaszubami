# Netlify / Cloudflare Pages — nagłówki i cache
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; form-action 'self' mailto:; base-uri 'self'

/assets/img/*
  Cache-Control: public, max-age=31536000
/assets/fonts/*
  Cache-Control: public, max-age=31536000
/assets/css/*
  Cache-Control: public, max-age=604800, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=604800, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
